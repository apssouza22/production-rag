# arXiv Paper Curator - Environment Configuration (EXAMPLE)
# Copy this file to .env and adjust values as needed

# Application Settings
DEBUG=true
ENVIRONMENT=development

# PostgreSQL Database
POSTGRES_DATABASE_URL=postgresql+psycopg2://rag_user:rag_password@postgres:5432/rag_db


LLM_PROVIDER=ollama
OLLAMA_HOST=http://ollama:11434
BIFROST_HOST=http://bifrost:8080

# arXiv API Configuration  
ARXIV__MAX_RESULTS=15
ARXIV__BASE_URL=https://export.arxiv.org/api/query
ARXIV__PDF_CACHE_DIR=./data/arxiv_pdfs
ARXIV__RATE_LIMIT_DELAY=3.0
ARXIV__TIMEOUT_SECONDS=60
ARXIV__SEARCH_CATEGORY=cs.AI
ARXIV__DOWNLOAD_MAX_RETRIES=3
ARXIV__DOWNLOAD_RETRY_DELAY_BASE=5.0
ARXIV__MAX_CONCURRENT_DOWNLOADS=5
ARXIV__MAX_CONCURRENT_PARSING=1

# PDF Parser Configuration
PDF_PARSER__MAX_PAGES=30
PDF_PARSER__MAX_FILE_SIZE_MB=20
PDF_PARSER__DO_OCR=false
PDF_PARSER__DO_TABLE_STRUCTURE=true

# OpenSearch Configuration (Single hybrid index for all search types)
OPENSEARCH__INDEX_NAME=arxiv-papers
OPENSEARCH__CHUNK_INDEX_SUFFIX=chunks
OPENSEARCH__MAX_TEXT_SIZE=1000000
OPENSEARCH_HOST=http://opensearch:9200
OPENSEARCH__HOST=http://opensearch:9200

# Vector Search Settings
OPENSEARCH__VECTOR_DIMENSION=1024
OPENSEARCH__VECTOR_SPACE_TYPE=cosinesimil

# Hybrid Search Settings  
OPENSEARCH__RRF_PIPELINE_NAME=hybrid-rrf-pipeline
OPENSEARCH__HYBRID_SEARCH_SIZE_MULTIPLIER=2

# Text Chunking Configuration
CHUNKING__CHUNK_SIZE=600
CHUNKING__OVERLAP_SIZE=100
CHUNKING__MIN_CHUNK_SIZE=100
CHUNKING__SECTION_BASED=true

# Contextual Retrieval (LLM-generated context prepended to chunks for search/embedding)
CHUNKING__CONTEXTUALIZATION_ENABLED=false
CHUNKING__CONTEXTUALIZATION_MODEL=
CHUNKING__MAX_DOCUMENT_CHARS=50000
CHUNKING__MAX_CONCURRENT_CONTEXT_REQUESTS=3

# Jina AI Embeddings (Required for hybrid search)
JINA_API_KEY=your_jina_api_key_here

# Bifrost + Ollama Configuration
BIFROST_API_KEY=sk-bf-agent-1-dev
# Per-agent virtual keys (see bifrost/config.json governance.virtual_keys)
BIFROST_API_KEY_AGENT_1=sk-bf-agent-1-dev
BIFROST_API_KEY_AGENT_2=sk-bf-agent-2-dev
# Comma-separated fallback chain when the primary model/provider fails (see bifrost/config.json for retries)
BIFROST_FALLBACK_MODELS=openai/gpt-5.6-luna,ollama/llama3.2:1b
# Comma-separated fallback models for direct Ollama (e.g. llama3.2:3b,llama3.2:1b)
OLLAMA_FALLBACK_MODELS=
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_MODEL=llama3.2:1b
AGENT_MODEL=gpt-5.6-luna
REASONING_EFFORT=low
OLLAMA_TIMEOUT=300
# Langfuse v4 Tracing — Langfuse Cloud (read by src/config.py via LANGFUSE__ prefix)
# Sign up at https://cloud.langfuse.com, create a project, then copy API keys from Settings → API Keys
LANGFUSE__ENABLED=true
LANGFUSE__HOST=https://cloud.langfuse.com
# EU region: https://cloud.langfuse.com | US region: https://us.cloud.langfuse.com
LANGFUSE__PUBLIC_KEY=pk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LANGFUSE__SECRET_KEY=sk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LANGFUSE__FLUSH_AT=15
LANGFUSE__FLUSH_INTERVAL=1.0
LANGFUSE__DEBUG=false   # true = DEBUG logs; false = INFO logs

# Redis Cache Configuration
REDIS__HOST=redis
REDIS__PORT=6379
# Leave empty since compose.yml Redis has no --requirepass configured
REDIS__PASSWORD=
REDIS__DB=0
REDIS__TTL_HOURS=6

# Airflow Settings
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=true
AIRFLOW__HOME=/opt/airflow
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://rag_user:rag_password@postgres:5432/rag_db