# Langfuse (required — same project as the RAG API traces)
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM judge for scoring traces
EVALUATION_LLM=gpt-4o-mini
EVALUATION_BASE_URL=https://api.openai.com/v1
EVALUATION_API_KEY=
EVALUATION_SLEEP_TIME=10

# Optional: route judge calls through Bifrost instead of OpenAI directly
BIFROST_ENABLED=false
BIFROST_HOST=http://localhost:8090
BIFROST_API_KEY=dummy-key
