{
  "pdf_parser": {
    "max_pages": 30,
    "max_file_size_mb": 20,
    "do_ocr": false,
    "do_table_structure": false,
    "do_figure_extraction": false
  },
  "chunking": {
    "chunk_size": 600,
    "overlap_size": 100,
    "min_chunk_size": 100,
    "section_based": true,
    "contextualization_enabled": false,
    "contextualization_model": "gpt-5.6-luna",
    "max_document_chars": 50000,
    "max_concurrent_context_requests": 3
  },
  "query": {
    "use_hybrid": true,
    "rerank_enabled": true,
    "rerank_model": "jina-reranker-v2-base-multilingual",
    "rerank_candidate_multiplier": 2
  },
  "experiment": {
    "evaluation_llm": "gpt-5.6-luna",
    "evaluation_base_url": "https://api.openai.com/v1",
    "experiment_ingestion_name": "evals-experiments-1",
    "experiment_questions_per_paper": 4,
    "experiment_chunks_per_paper": 12,
    "experiment_top_k": 5,
    "retrieval_mode": "kg"
  }
}
